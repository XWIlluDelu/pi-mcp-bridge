[Unit]
Description=Owner-controlled MCP client and Pi bridge
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=%h/.local/share/pi-mcp-bridge
ExecStartPre=/usr/bin/node %h/.local/share/pi-mcp-bridge/deploy/check-owner.mjs %h/.config/pi-mcp-bridge/owner.json
ExecStart=%h/.config/pi-mcp-bridge/run-client
EnvironmentFile=-%h/.config/pi-mcp-bridge/service.env
UMask=0077
StandardInput=null
StandardOutput=null
StandardError=journal
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=90

[Install]
WantedBy=default.target
